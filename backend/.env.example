# Graphwar backend
GRAPHWAR_ADDR=:8080
GRAPHWAR_LOG_LEVEL=info

# Скопируйте в backend/.env (в git не попадает) или экспортируйте вручную.
# Без DSN сервер работает без базы данных (гостевые комнаты в памяти).
# DSN по умолчанию совпадает с docker-compose.yml.
GRAPHWAR_DB_DSN=postgres://graphwar:graphwar@127.0.0.1:5432/graphwar
